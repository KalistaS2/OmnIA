# ──────────────────────────────────────────────
# Omnia Backend — Variáveis de Ambiente
# Copie para .env e preencha com seus valores
# ──────────────────────────────────────────────

# ── Gemini ───────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Google Cloud ─────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us

# ── Document AI ──────────────────────────────
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id-here

# ── Google Cloud Storage ─────────────────────
GCS_BUCKET_PROCESSOS=your-bucket-name
# Para dev local sem GCS, usar armazenamento em disco:
STORAGE_BACKEND=local
# LOCAL_STORAGE_PATH=./storage

# ── MongoDB ──────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=omnia

# ── Limites ──────────────────────────────────
MAX_PDF_SIZE_MB=100
MAX_PAGES_PER_REQUEST=200
MAX_QUESTIONS_PER_QUESTIONNAIRE=50

# ── Timeouts (segundos) ─────────────────────
OCR_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=120

# ── Observabilidade ──────────────────────────
LOG_LEVEL=INFO
